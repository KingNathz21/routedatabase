# Local-only environment variables for the Cloudflare Worker.
# Copy these values into worker/.dev.vars for local Wrangler development.
# Never commit .dev.vars, .env, API tokens, service-account keys or passwords.

FIREBASE_PROJECT_ID=rflofficial

# The production Worker uses a Cloudflare secret instead:
# npx wrangler secret put FIREBASE_PROJECT_ID --config worker/wrangler.jsonc
